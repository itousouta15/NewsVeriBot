# Google Fact Check Tools API。未設定時仍可執行主張偵測，但不會查詢查核報告。
GOOGLE_FACT_CHECK_API_KEY=

# Discord Bot。只有執行 Discord adapter 時需要。
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord adapter 呼叫的 NewsVeriBot API。
NEWSVERIBOT_API_BASE_URL=http://127.0.0.1:8000

# API 與擷取限制。
NEWSVERIBOT_LOG_LEVEL=INFO
NEWSVERIBOT_HTTP_TIMEOUT_SECONDS=10
NEWSVERIBOT_MAX_DOWNLOAD_BYTES=2000000
NEWSVERIBOT_MAX_ARTICLE_CHARS=20000
NEWSVERIBOT_MAX_CLAIMS=5
